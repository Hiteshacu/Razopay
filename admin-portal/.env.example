# Backend API
VITE_API_BASE_URL=https://trust-shield-api.onrender.com

# Firebase web config — Project settings > General > Your apps > Web app.
# These are not secrets: they identify the project and are visible to any
# browser that loads the portal. Access is enforced by Firebase security
# rules and by the backend verifying the ID token it receives.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=
