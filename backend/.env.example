# Copy to backend/.env for local development. Never commit the real file.
# On Render these are set in the dashboard instead, not in a file.

# --- Firebase ---
# Local: path relative to backend/. On Render: /etc/secrets/serviceAccountKey.json
FIREBASE_CREDENTIALS=secrets/serviceAccountKey.json

# --- Storage ---
USE_LOCAL_STORAGE=true
LOCAL_UPLOAD_DIR=uploads
FIREBASE_STORAGE_BUCKET=
STORAGE_MAKE_PUBLIC=false
STORAGE_SIGNED_URL_MINUTES=1440

# --- Where the engine writes at runtime ---
# Leave these unset locally (defaults to the project folder).
# On Render they point at the mounted persistent disk so the registry,
# audit trail and encrypted keys survive a redeploy.
# DTS_DATA_DIR=/data
# SECURE_KEYS_DIR=/data/secure_private_keys

# --- Keys and admin access ---
MASTER_KEY=PASTE_FERNET_KEY_FROM_generate_master_key.py
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_before_deploying

# Whether Firebase ID tokens are actually verified. Defaults to false so a
# fresh checkout runs without a Firebase project, and MUST be true anywhere
# reachable from the internet — with it off, verify_identity() waves every
# request through as the owner, so anyone who finds the URL can create
# authorities and sign documents.
#
# It also decides whether signers have names. With auth off the caller has no
# email, username_for(None) returns "", and every key is stored with an empty
# owner_username — which the public verifier searches by, so no signer is ever
# findable and every lookup comes back empty.
REQUIRE_ADMIN_AUTH=true

# The account that may see every signer's records. Everyone else, including
# other admins, sees only their own.
OWNER_EMAIL=you@example.com
ADMIN_EMAILS=you@example.com

# Accounts approved on sight, as ordinary members. Comma separated.
#
# For a shared demo login that has to work with nobody awake to approve it.
# Deliberately not ADMIN_EMAILS: that would also make it an administrator, and
# an account whose password ships to every visitor must not be able to approve
# other accounts. This grants one thing — sign in and use the console.
DEMO_EMAILS=default@gmail.com

# --- Approval email ---
# Who is told when somebody requests access. Falls back to OWNER_EMAIL.
APPROVAL_NOTIFY_EMAIL=you@example.com
# Where the link in that email points.
PORTAL_BASE_URL=https://your-portal.onrender.com

# Pick ONE transport.
#
# Resend goes over HTTPS on 443, which is why it is first: many hosts block
# outbound SMTP ports outright, and a mail path that silently cannot connect
# is worse than none. onboarding@resend.dev works without a verified domain.
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

# Or Gmail. SMTP_PASSWORD is a Google App Password, never the account
# password — Google refuses plain passwords from applications, and an App
# Password can be revoked on its own without changing your sign-in.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# --- CORS ---
# Local dev servers; on Render set this to the admin portal's HTTPS origin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Chatbot ---
TAVILY_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
