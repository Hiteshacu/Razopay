# Copy to backend/.env for local development. Never commit the real file.
# On Render these are set in the dashboard instead, not in a file.

# --- Firebase ---
# Local: path relative to backend/. On Render: /etc/secrets/serviceAccountKey.json
FIREBASE_CREDENTIALS=secrets/serviceAccountKey.json

# --- Storage ---
USE_LOCAL_STORAGE=true
LOCAL_UPLOAD_DIR=uploads
FIREBASE_STORAGE_BUCKET=
STORAGE_MAKE_PUBLIC=false
STORAGE_SIGNED_URL_MINUTES=1440

# --- Where the engine writes at runtime ---
# Leave these unset locally (defaults to the project folder).
# On Render they point at the mounted persistent disk so the registry,
# audit trail and encrypted keys survive a redeploy.
# DTS_DATA_DIR=/data
# SECURE_KEYS_DIR=/data/secure_private_keys

# --- Keys and admin access ---
MASTER_KEY=PASTE_FERNET_KEY_FROM_generate_master_key.py
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_before_deploying

# --- CORS ---
# Local dev servers; on Render set this to the admin portal's HTTPS origin.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Chatbot ---
TAVILY_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
